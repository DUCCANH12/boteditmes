{
  "version": 2,
  "functions": {
    "api/webhook.js": {
      "maxDuration": 10
    },
    "api/setup.js": {
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/setup",
      "dest": "/api/setup.js"
    }
  ]
}
